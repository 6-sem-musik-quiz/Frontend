@page "/lobby/{Id:guid}"
@* SCRUM-111: lobby-siden. Ændringer går gennem REST; spillerlisten opdateres live via LobbyHub (SignalR).
   Kan hubben ikke nås, hentes lobbyen i stedet hvert 5. sekund. *@
@implements IAsyncDisposable
@using Frontend.Services.Errors
@inject ILobbyApiClient Lobbies
@inject ILobbyHub Hub
@inject ILobbyAudio Audio
@inject ApiCallHandler ApiCall
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider TimeProvider

<PageTitle>Lobby · Slopster</PageTitle>

<ErrorMessage Message="@_error" />

@if (_notFound)
{
    <p>Lobbyen findes ikke (længere). <a href="">Tilbage til forsiden</a></p>
}
else if (_lobby is { } lobby)
{
    <div class="lobby-layout">
        <aside class="lobby-side">
            <h1 class="sl-plate h5 mb-0">@lobby.Settings.CategoryName</h1>

            @if (lobby.IsPrivate && lobby.Code is { } joinCode)
            {
                <section class="card p-3">
                    <div class="sl-label">Kode (privat)</div>
                    <div class="lobby-code" data-testid="code">@joinCode</div>
                    <button type="button" class="btn btn-sm mt-2" @onclick="() => CopyCodeAsync(joinCode)">
                        @(_copied ? "Kopieret ✓" : "Kopiér")
                    </button>
                </section>
            }

            <section class="card px-3 py-1" aria-label="Indstillinger">
                <dl class="lobby-kv mb-0" data-testid="settings">
                    <div><dt>Svartid</dt><dd>@lobby.Settings.AnswerTimeSeconds s</dd></div>
                    <div><dt>Runder</dt><dd>@lobby.Settings.Rounds</dd></div>
                    <div><dt>Pladser</dt><dd>@lobby.Players.Count / @lobby.Settings.MaxPlayers</dd></div>
                </dl>
            </section>

            <LoadingButton CssClass="btn-outline-danger" OnClick="LeaveAsync" LoadingText="Forlader…">Forlad lobby</LoadingButton>

            @if (!_live)
            {
                <span class="badge text-bg-warning align-self-start" data-testid="not-live" title="Live-opdatering virker ikke; siden opdateres hvert 5. sekund.">Ikke live</span>
            }
        </aside>

        <div class="lobby-main">
            <div class="sl-banner">· · · Venter på spillere · · ·</div>

            <ul class="lobby-seats list-unstyled mb-0" data-testid="players" aria-label="Spillere">
                @foreach (var player in lobby.Players)
                {
                    <li @key="player.UserId" class="card lobby-seat" data-testid="player">
                        <span class="lobby-seat-name">
                            @if (player.UserId == lobby.HostUserId)
                            {
                                <span title="Vært" aria-label="Vært">👑 </span>
                            }
                            @player.UserName
                            @if (player.UserId == _userId)
                            {
                                <span class="text-body-secondary"> (dig)</span>
                            }
                        </span>
                        @if (player.IsReady)
                        {
                            <span class="lobby-pill ready" aria-label="Klar" data-testid="ready">✓ Klar</span>
                        }
                        else
                        {
                            <span class="lobby-pill">Ikke klar</span>
                        }
                    </li>
                }
                @for (var i = lobby.Players.Count; i < lobby.Settings.MaxPlayers; i++)
                {
                    <li class="lobby-seat empty" aria-hidden="true">Ledig plads</li>
                }
            </ul>

            <div class="lobby-bar">
                <span class="lobby-status">
                    @if (IsHost && StartBlockedReason is { } reason)
                    {
                        <span data-testid="start-reason">@reason</span>
                    }
                    else if (IsHost)
                    {
                        <span>Alle er klar</span>
                    }
                    else
                    {
                        <span>Værten starter spillet, når alle er klar.</span>
                    }
                </span>
                <div class="d-flex flex-wrap gap-3">
                    <LoadingButton CssClass="btn-outline-success" OnClick="ToggleReadyAsync"
                                   LoadingText="Gemmer…" data-testid="ready-button">
                        @(Me?.IsReady == true ? "Ikke klar" : "Klar")
                    </LoadingButton>
                    @if (IsHost)
                    {
                        <LoadingButton CssClass="btn-primary" OnClick="StartAsync" LoadingText="Starter…"
                                       Disabled="@(StartBlockedReason is not null)" data-testid="start-button">Start spil</LoadingButton>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (_error is null)
{
    <p class="text-body-secondary">Henter lobby…</p>
}

@code {
    public static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);
    public static readonly TimeSpan JoinThrottle = TimeSpan.FromMilliseconds(400);

    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private LobbyDto? _lobby;
    private int? _userId;
    private string? _error;
    private bool _notFound;
    private bool _live;
    private bool _copied;
    private bool _leaving;
    private Timer? _pollTimer;
    private DateTimeOffset? _lastJoinAt;

    private LobbyPlayerDto? Me => _lobby?.Players.FirstOrDefault(p => p.UserId == _userId);
    private bool IsHost => _lobby is not null && _lobby.HostUserId == _userId;

    // Why the host cannot start yet, or null when they can.
    private string? StartBlockedReason
    {
        get
        {
            if (_lobby is not { } lobby)
                return null;
            var missing = 2 - lobby.Players.Count;
            if (missing > 0)
                return missing == 1 ? "Venter på 1 spiller mere." : $"Venter på {missing} spillere mere.";
            var notReady = lobby.Players.Count(p => !p.IsReady);
            if (notReady > 0)
                return notReady == 1 ? "Venter på, at 1 spiller bliver klar." : $"Venter på, at {notReady} spillere bliver klar.";
            return null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        double volume = 0.8;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "slopster.sfx-volume");
            if (stored is not null && double.TryParse(stored, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out var parsed))
                volume = Math.Clamp(parsed, 0, 1);
        }
        catch (JSException) { }
        await Audio.SetVolumeAsync(volume);
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (int.TryParse(user.FindFirst("sub")?.Value, out var id))
                _userId = id;
        }

        await LoadAsync();
        if (_lobby is null)
            return;

        Hub.LobbyUpdated += OnLobbyUpdated;
        Hub.GameStarted += OnGameStarted;
        Hub.LobbyClosed += OnLobbyClosed;
        try
        {
            await Hub.ConnectAsync(Id);
            _live = true;
        }
        catch (Exception)
        {
            // No live updates (hub down, or the edge does not forward it): fall back to polling.
            _pollTimer = new Timer(_ => InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            }), null, PollInterval, PollInterval);
        }
    }

    // 404 = the lobby is gone, or it is private and we are not in it.
    private async Task LoadAsync()
    {
        _error = await ApiCall.RunAsync(async () =>
        {
            try
            {
                _lobby = await Lobbies.GetLobbyAsync(Id);
            }
            catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
            {
                _notFound = true;
                _lobby = null;
            }
        });
    }

    private Task OnLobbyUpdated(LobbyDto lobby) => InvokeAsync(async () =>
    {
        if (lobby.Id != Id)
            return;
        var old = _lobby;
        _lobby = lobby;
        if (old is not null)
            await PlayLobbyEventSoundsAsync(old, lobby);
        StateHasChanged();
    });

    private async Task PlayLobbyEventSoundsAsync(LobbyDto old, LobbyDto next)
    {
        var oldIds = old.Players.Select(p => p.UserId).ToHashSet();
        var newIds = next.Players.Select(p => p.UserId).ToHashSet();

        if (newIds.Except(oldIds).Any())
        {
            var now = TimeProvider.GetUtcNow();
            if (_lastJoinAt is null || (now - _lastJoinAt.Value) >= JoinThrottle)
            {
                _lastJoinAt = now;
                await Audio.PlayPlayerJoinedAsync();
            }
        }

        if (oldIds.Except(newIds).Any())
            await Audio.PlayPlayerLeftAsync();

        bool wasAllReady = old.Players.Count > 0 && old.Players.All(p => p.IsReady);

        foreach (var player in next.Players)
        {
            var oldPlayer = old.Players.FirstOrDefault(p => p.UserId == player.UserId);
            if (oldPlayer is null)
                continue;
            if (!oldPlayer.IsReady && player.IsReady)
                await Audio.PlayPlayerReadyAsync();
            else if (oldPlayer.IsReady && !player.IsReady)
                await Audio.PlayPlayerNotReadyAsync();
        }

        if (next.Players.Count >= 2 && next.Players.All(p => p.IsReady) && !wasAllReady)
            await Audio.PlayAllReadyAsync();

        if (next.Players.Count == next.Settings.MaxPlayers && old.Players.Count < old.Settings.MaxPlayers)
            await Audio.PlayLobbyFullAsync();
    }

    private Task OnGameStarted(Guid gameId) => InvokeAsync(async () =>
    {
        await Audio.PlayAllReadyAsync();
        Navigation.NavigateTo($"spil/{gameId}");
    });

    // The last player left. If that was us, LeaveAsync already navigates.
    private Task OnLobbyClosed() => InvokeAsync(() =>
    {
        if (!_leaving)
            Navigation.NavigateTo("?lukket=1");
    });

    private async Task ToggleReadyAsync()
    {
        var ready = Me?.IsReady != true;
        _error = await ApiCall.RunAsync(async () => _lobby = await Lobbies.SetReadyAsync(Id, ready), messageFor: LobbyMessages.For);
    }

    private async Task LeaveAsync()
    {
        _leaving = true;
        _error = await ApiCall.RunAsync(() => Lobbies.LeaveLobbyAsync(Id), messageFor: LobbyMessages.For);
        if (_error is null)
            Navigation.NavigateTo("");
        else
            _leaving = false;
    }

    private async Task StartAsync()
    {
        StartGameResponse? started = null;
        _error = await ApiCall.RunAsync(async () => started = await Lobbies.StartGameAsync(Id), messageFor: LobbyMessages.For);
        if (started is not null)
            Navigation.NavigateTo($"spil/{started.GameId}");
    }

    private async Task CopyCodeAsync(string code)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
            _copied = true;
        }
        catch (JSException)
        {
            // Clipboard not allowed (e.g. not https); the code is on screen anyway.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _pollTimer?.Dispose();
        Hub.LobbyUpdated -= OnLobbyUpdated;
        Hub.GameStarted -= OnGameStarted;
        Hub.LobbyClosed -= OnLobbyClosed;
        await Hub.DisposeAsync();
    }
}
