@page "/examples"
@using Frontend.Domain.DTOs
@using Frontend.Services.Interfaces
@inject IExampleApiClient ExampleApiClient
@inject ILogger<Examples> Logger
@attribute [StreamRendering]

@* Placeholder showing the pattern end to end: page -> API client -> backend service. Replace with real pages. *@

<PageTitle>Examples</PageTitle>

<h1>Examples</h1>
<p>Fetched from UserService <code>GET /api/example</code>.</p>

@if (_error is not null)
{
    <div class="alert alert-warning" role="alert">@_error</div>
}
else if (_examples is null)
{
    <p><em>Loading…</em></p>
}
else if (_examples.Count == 0)
{
    <p>No examples yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var example in _examples)
            {
                <tr>
                    <td>@example.Name</td>
                    <td>@example.Description</td>
                    <td>@example.CreatedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ExampleResponse>? _examples;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _examples = await ExampleApiClient.GetAllAsync();
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Could not reach UserService");
            _error = "Could not reach UserService. Is it running?";
        }
    }
}
