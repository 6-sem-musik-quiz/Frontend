@page "/dev/spil"
@* SCRUM-148/152: try the game round's UI without a backend. Only in Development (dotnet run); in a
   published build the page says it does not exist. Sample data, a local countdown and three fake
   rivals: Asger answers right after 6 s, Benjamin wrong after 13 s, Frederik not at all. *@
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@implements IDisposable
@inject IWebAssemblyHostEnvironment Environment

<PageTitle>Spil (forhåndsvisning)</PageTitle>

@if (!Environment.IsDevelopment())
{
    <p>Siden findes ikke.</p>
}
else if (_end is not null)
{
    @* SCRUM-155: the staged end screen with sample data (the design's four players). *@
    <EndReveal @key="_end" Ended="_end" Me="3" Actions="BackToRound" />
}
else
{
    <GameLayout>
        <Side>
            <GameSidebar Round="_round" TotalRounds="TotalRounds" SecondsLeft="_secondsLeft" AnswerTimeSeconds="AnswerTime" />
        </Side>
        <ChildContent>
            <RivalTable Rivals="RivalViews" TotalRounds="TotalRounds" />
            <RoundCountdown Round="_round" TotalRounds="TotalRounds" StartsIn="_preRoll" Go="_go" Standing="Du har 3 point · nr. 2 af 4" />
            <HandOfCards Cards="_timeline" Round="_round" Locked="@(_secondsLeft == 0 || _preRoll is not null)" Reveal="_reveal" OnConfirm="Confirmed">
                <Left><DeckPile RoundsLeft="@(TotalRounds - _round)" /></Left>
                <Right><DiscardPile Songs="_played" /></Right>
            </HandOfCards>
        </ChildContent>
    </GameLayout>

    <div class="d-flex gap-2 mt-4 flex-wrap">
        <button class="btn btn-sm" @onclick="EndRound" disabled="@(_reveal is not null)">Afslut runden</button>
        <button class="btn btn-sm" @onclick="NextRound" disabled="@(_reveal is null)">Næste runde</button>
        <button class="btn btn-sm" @onclick="FillHand" data-testid="fill-hand">Fyld hænderne (20 kort)</button>
        <button class="btn btn-sm" @onclick="PlayEnd">Afspil afslutningen</button>
        <span class="text-body-secondary small align-self-center">
            Forhåndsvisning med eksempeldata (kun i Development). Rundens sang er @Song.Title (@Song.Year).
        </span>
    </div>
}

@code {
    private const int AnswerTime = 30;
    private const int TotalRounds = 10;

    private static readonly CardDto[] Songs =
    [
        new("Billie Jean", ["Michael Jackson"], 1982),
        new("Wonderwall", ["Oasis"], 1995),
        new("Hey Ya!", ["OutKast"], 2003),
        new("Bohemian Rhapsody", ["Queen"], 1975),
        new("Rolling in the Deep", ["Adele"], 2010)
    ];

    private sealed class DevRival(int id, string name, int answerAfterSeconds, bool answersRight, params int[] years)
    {
        public int Id { get; } = id;
        public string Name { get; } = name;
        public int AnswerAfterSeconds { get; } = answerAfterSeconds; // 0 = never answers
        public bool AnswersRight { get; } = answersRight;
        public List<CardDto> Cards { get; set; } = years.Select(y => new CardDto($"Sang fra {y}", ["Kunstner"], y)).ToList();
        public List<bool> History { get; } = [true, false, true];
        public RivalStamp? Stamp { get; set; }
        public RivalReveal? Reveal { get; set; }
        public int? Slot { get; set; }
    }

    private readonly List<DevRival> _rivals =
    [
        new(2, "Asger", 6, true, 1972, 1985, 1991, 1999),
        new(3, "Benjamin", 13, false, 1979, 1991, 2005),
        new(4, "Frederik", 0, false, 1972, 1988, 2012)
    ];

    private List<CardDto> _timeline =
    [
        new("Dancing Queen", ["ABBA"], 1976),
        new("Take On Me", ["a-ha"], 1985),
        new("Smells Like Teen Spirit", ["Nirvana"], 1991),
        new("Kun for mig", ["Medina"], 2009),
        new("Somebody That I Used to Know", ["Gotye", "Kimbra"], 2011)
    ];

    // Rounds 1-3 before the preview starts in round 4.
    private readonly List<PlayedSong> _played =
    [
        new(1, new("Take On Me", ["a-ha"], 1985), Correct: true, Answered: true),
        new(2, new("Hey Ya!", ["OutKast"], 2003), Correct: false, Answered: true),
        new(3, new("Wonderwall", ["Oasis"], 1995), Correct: false, Answered: false)
    ];

    private int _round = 4;
    private int _secondsLeft = AnswerTime;
    private int? _mySlot;
    private RoundReveal? _reveal;
    private Timer? _timer;
    private int? _preRoll; // SCRUM-169: 3, 2, 1 before the round's time starts
    private bool _go;

    private CardDto Song => Songs[(_round - 4) % Songs.Length];

    private List<RivalView> RivalViews =>
        _rivals.Select(r => new RivalView(r.Id, r.Name, r.Cards, r.History, r.Stamp, r.Reveal)).ToList();

    protected override void OnInitialized()
    {
        if (Environment.IsDevelopment())
            _timer = new Timer(_ => InvokeAsync(Tick), null, 1000, 1000);
    }

    private void Tick()
    {
        if (_go)
        {
            _go = false;
            StateHasChanged();
        }
        if (_preRoll is { } left)
        {
            _preRoll = left > 1 ? left - 1 : null;
            _go = _preRoll is null;
            StateHasChanged();
            return;
        }
        if (_reveal is not null || _secondsLeft == 0)
            return;
        _secondsLeft--;
        var elapsed = AnswerTime - _secondsLeft;
        foreach (var rival in _rivals.Where(r => r.AnswerAfterSeconds == elapsed))
        {
            var right = RightSlot(rival.Cards);
            rival.Slot = rival.AnswersRight ? right : (right == 0 ? rival.Cards.Count : 0);
            rival.Stamp = new RivalStamp(_rivals.Count(r => r.Stamp is not null) + 1, elapsed * 1000 + 300);
        }
        if (_secondsLeft == 0) EndRound();
        StateHasChanged();
    }

    private void Confirmed(int slot) => _mySlot = slot;

    private int RightSlot(List<CardDto> cards) => cards.Count(c => c.Year <= Song.Year);

    private bool IsRight(List<CardDto> cards, int slot) =>
        (slot == 0 || cards[slot - 1].Year <= Song.Year) && (slot == cards.Count || Song.Year <= cards[slot].Year);

    private void EndRound()
    {
        _reveal = new RoundReveal(Song, _mySlot is not null, _mySlot is { } s && IsRight(_timeline, s));
        _played.Add(new PlayedSong(_round, Song, _reveal.Correct, _reveal.Answered));
        foreach (var rival in _rivals)
        {
            var right = rival.Slot is { } slot && IsRight(rival.Cards, slot);
            if (right)
                rival.Cards.Insert(rival.Slot!.Value, Song);
            rival.History.Add(right);
            rival.Reveal = new RivalReveal(Song, right, rival.Slot);
        }
    }

    private void NextRound()
    {
        if (_reveal is { Correct: true } && _mySlot is { } slot)
            _timeline.Insert(slot, Song);
        _round++;
        _secondsLeft = AnswerTime;
        _preRoll = 3;
        _mySlot = null;
        _reveal = null;
        foreach (var rival in _rivals)
        {
            rival.Stamp = null;
            rival.Reveal = null;
            rival.Slot = null;
        }
    }

    // The biggest hands a 20-round game can give, to check that they fit without a scrollbar.
    private void FillHand()
    {
        var years = new[] { 1958, 1964, 1967, 1969, 1971, 1973, 1977, 1979, 1983, 1987, 1989, 1993, 1997, 2001, 2005, 2014, 2017, 2020, 2022, 2024 };
        List<CardDto> Fill(List<CardDto> cards) => cards
            .Concat(years.Where(y => cards.All(c => c.Year != y)).Take(Math.Max(0, 20 - cards.Count))
                .Select(y => new CardDto($"Sang fra {y}", ["Kunstner"], y)))
            .OrderBy(c => c.Year)
            .ToList();
        _timeline = Fill(_timeline);
        foreach (var rival in _rivals)
            rival.Cards = Fill(rival.Cards);
    }

    // SCRUM-155: Benjamin 6, Asger 5, Mathias (me) 5, Frederik 4 after the rounds; Asger takes both awards.
    private GameEndedDto? _end;

    private RenderFragment BackToRound => @<button type="button" class="btn btn-primary" @onclick="() => _end = null">Tilbage til runden</button>;

    private void PlayEnd() => _end = new GameEndedDto(Guid.NewGuid(),
        [
            new StandingDto(2, "Asger", 7, 5, 10, 1, []),
            new StandingDto(1, "Benjamin", 6, 6, 10, 2, []),
            new StandingDto(3, "Mathias", 5, 5, 9, 3, []),
            new StandingDto(4, "Frederik", 4, 4, 8, 4, [])
        ],
        [
            new AwardDto("fastest", [2],
                [new AwardContenderDto(2, 6100, true), new AwardContenderDto(1, 7400, true),
                 new AwardContenderDto(3, 9800, true), new AwardContenderDto(4, 5200, false)]),
            new AwardDto("streak", [2],
                [new AwardContenderDto(2, 5, true), new AwardContenderDto(1, 4, true),
                 new AwardContenderDto(3, 3, true), new AwardContenderDto(4, 2, true)])
        ]);

    public void Dispose() => _timer?.Dispose();
}
