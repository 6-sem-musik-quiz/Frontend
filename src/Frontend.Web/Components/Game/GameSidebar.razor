@* SCRUM-148: left column of the game round (UI-design v1, board 3): round and countdown, plus anything
   the page adds below (ChildContent, e.g. the volume). The players sit at the card table (RivalTable,
   SCRUM-152) instead of in a list here. *@
@using System.Globalization

<aside class="gs" aria-label="@T("Spilstatus", "Game status")">
    <div class="card gs-box">
        <div class="sl-label">@T("Runde", "Round")</div>
        <div class="gs-big px" data-testid="round">@Round / @TotalRounds</div>
    </div>

    <div class="card gs-box">
        <div class="sl-label">@T("Tid", "Time")</div>
        <div class="gs-big px gs-time" data-testid="time" aria-live="off">@(SecondsLeft?.ToString(CultureInfo.InvariantCulture) ?? "–")</div>
        <div class="gs-bar" aria-hidden="true"><div class="gs-bar-fill" style="@BarStyle" data-testid="time-bar"></div></div>
    </div>

    @ChildContent
</aside>

@code {
    [Parameter] public int Round { get; set; }
    [Parameter] public int TotalRounds { get; set; }

    // Null before the round's playback has started.
    [Parameter] public int? SecondsLeft { get; set; }
    [Parameter] public int AnswerTimeSeconds { get; set; } = 30;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string BarStyle
    {
        get
        {
            var fraction = SecondsLeft is { } s && AnswerTimeSeconds > 0 ? Math.Clamp(s / (double)AnswerTimeSeconds, 0, 1) : 0;
            return string.Create(CultureInfo.InvariantCulture, $"width:{fraction * 100:0.#}%");
        }
    }
}
