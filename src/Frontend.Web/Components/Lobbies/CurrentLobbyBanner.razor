@* Viser lobbyen, brugeren stadig er i (GET /api/lobbies/mine), så man kan komme tilbage til den eller forlade den.
   Fx hvis man forlod siden uden at trykke "Forlad lobby": ellers kan man hverken oprette eller joine en ny. *@
@inject ILobbyApiClient Lobbies
@inject ApiCallHandler ApiCall
@inject NavigationManager Navigation

<ErrorMessage Message="@_error" />

@if (_lobby is { } lobby)
{
    <div class="card current-lobby" role="status" data-testid="current-lobby">
        <span class="current-lobby-plate">Din lobby</span>
        <span class="current-lobby-text">
            Du er stadig i <span class="current-lobby-name">@lobby.Settings.CategoryName</span>
            <span class="current-lobby-count">@lobby.Players.Count/@lobby.Settings.MaxPlayers spillere</span>
        </span>
        <div class="current-lobby-actions">
            <a class="btn btn-primary" href="lobby/@lobby.Id">Gå til lobby</a>
            <LoadingButton CssClass="btn-outline-danger" OnClick="LeaveAsync" LoadingText="Forlader…">Forlad lobby</LoadingButton>
        </div>
    </div>
}

@code {
    private LobbyDto? _lobby;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Only for the banner: if it cannot be loaded, the rest of the page still works.
        await ApiCall.RunAsync(async () => _lobby = await Lobbies.GetMyLobbyAsync());
    }

    private async Task LeaveAsync()
    {
        if (_lobby is not { } lobby)
            return;

        _error = await ApiCall.RunAsync(() => Lobbies.LeaveLobbyAsync(lobby.Id), messageFor: LobbyMessages.For);
        if (_error is null)
            _lobby = null;
    }
}
