@* Bekræftelsesdialog (Bootstrap-modal uden JS). Vises, når Visible er true. *@

@if (Visible)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" data-testid="confirm-dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5">@(Title ?? T("Er du sikker?", "Are you sure?"))</h2>
                    <button type="button" class="btn-close" aria-label="@T("Luk", "Close")" @onclick="OnCancel"></button>
                </div>
                <div class="modal-body">@ChildContent</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="OnCancel">@T("Annuller", "Cancel")</button>
                    <LoadingButton CssClass="@ConfirmCss" OnClick="OnConfirm" LoadingText="@T("Vent…", "Wait…")" data-testid="confirm">@(ConfirmText ?? T("Slet", "Delete"))</LoadingButton>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string? Title { get; set; }        // default "Er du sikker?"
    [Parameter] public string? ConfirmText { get; set; }  // default "Slet"
    [Parameter] public string ConfirmCss { get; set; } = "btn-danger";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}
