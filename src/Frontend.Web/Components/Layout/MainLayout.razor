@inherits LayoutComponentBase
@implements IDisposable
@inject ISoundEffects Sounds
@inject IBackgroundMusic Music
@inject NavigationManager Navigation
@inject MaintenanceState Maintenance

<div class="page">
    <TopBar />
    <MaintenanceBanner />

    <main>
        <article class="content container py-3">
            @Body
        </article>
    </main>
</div>

<ToastHost />

<div id="blazor-error-ui" data-nosnippet>
    @Lang.T("Der opstod en uventet fejl.", "An unexpected error has occurred.")
    <a href="." class="reload">@Lang.T("Genindlæs", "Reload")</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // SCRUM-163: hover and click sounds on every button and link.
    // SCRUM-167: quiet music on the front page and in the lobby; it fades out on the other pages.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        Navigation.LocationChanged += OnLocationChanged;
        Maintenance.Changed += OnMaintenanceChanged;
        Lang.Changed += OnLanguageChanged;
        Maintenance.Start(); // SCRUM-176: poll the maintenance flags
        await Sounds.InstallUiAsync();
        await SetMusicAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = SetMusicAsync();

    // SCRUM-180: the menu music stops quietly while MusicService is switched off, and comes back after.
    private void OnMaintenanceChanged() => _ = InvokeAsync(SetMusicAsync);

    // The layout is not a LocalizedComponentBase (it inherits LayoutComponentBase), so it listens itself.
    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SetMusicAsync() =>
        // A page without music ("admin") while it is off; "" would be the front page, which has music.
        Music.SetPageAsync(Maintenance.IsOff("musicservice") ? "admin" : Navigation.ToBaseRelativePath(Navigation.Uri));

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Maintenance.Changed -= OnMaintenanceChanged;
        Lang.Changed -= OnLanguageChanged;
    }
}
