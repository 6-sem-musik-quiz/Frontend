@inherits LayoutComponentBase
@implements IDisposable
@inject ISoundEffects Sounds
@inject IBackgroundMusic Music
@inject NavigationManager Navigation

<div class="page">
    <TopBar />

    <main>
        <article class="content container py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Der opstod en uventet fejl.
    <a href="." class="reload">Genindlæs</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // SCRUM-163: hover and click sounds on every button and link.
    // SCRUM-167: quiet music on the front page and in the lobby; it fades out on the other pages.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        Navigation.LocationChanged += OnLocationChanged;
        await Sounds.InstallUiAsync();
        await Music.SetPageAsync(Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = Music.SetPageAsync(Navigation.ToBaseRelativePath(e.Location));

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
