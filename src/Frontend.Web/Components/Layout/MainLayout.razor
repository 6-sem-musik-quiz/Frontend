@inherits LayoutComponentBase
@implements IDisposable
@inject ISoundEffects Sounds
@inject NavigationManager Navigation

<div class="page">
    <TopBar />

    <main>
        <article class="content container py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Der opstod en uventet fejl.
    <a href="." class="reload">Genindlæs</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // SCRUM-163: hover and click sounds everywhere, and a card slide when the page changes.
    // The game page is left out: the round start has its own sound.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        Navigation.LocationChanged += OnLocationChanged;
        await Sounds.InstallUiAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = Navigation.ToBaseRelativePath(e.Location);
        if (!path.StartsWith("spil/", StringComparison.Ordinal))
            _ = Sounds.PlayAsync(Sfx.Navigate);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
