@* SCRUM-176: shows ToastService's messages in the corner. One instance, in MainLayout. *@
@implements IDisposable
@inject ToastService Toasts

<div class="toast-host" aria-live="polite" data-testid="toasts">
    @foreach (var toast in Toasts.Toasts)
    {
        <div @key="toast.Id" class="app-toast" role="status" data-testid="toast">
            <span>@toast.Text</span>
            <button type="button" class="btn-close btn-close-white ms-2" aria-label="@T("Luk", "Close")" @onclick="() => Toasts.Dismiss(toast.Id)"></button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Toasts.Changed -= OnChanged;
}
