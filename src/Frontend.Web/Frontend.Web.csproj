<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Blazor WebAssembly: "dotnet publish" gives static files in wwwroot, which nginx serves (see Dockerfile). -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Frontend.Domain\Frontend.Domain.csproj" />
    <ProjectReference Include="..\Frontend.Services\Frontend.Services.csproj" />
  </ItemGroup>
</Project>
